<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BusinessHarness.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="Inter" /></Style>
    <Style Selector="SelectableTextBlock"><Setter Property="FontFamily" Value="Inter" /></Style>
    <Style Selector="TextBox"><Setter Property="FontFamily" Value="Inter" /><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="14,10" /><Setter Property="FontFamily" Value="Inter" /></Style>
    <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#2A2A2A" /></Style>
    <Style Selector="Button.icon"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.round"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="CornerRadius" Value="17" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Background" Value="#ECECEC" /><Setter Property="Foreground" Value="#212121" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#ECECEC" /><Setter Property="Foreground" Value="#212121" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.suggestion"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#3A3A3A" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="20" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="16,8" /></Style>
    <Style Selector="Button.suggestion:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#2A2A2A" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9E9E9E" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="#6E6E6E" /><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#2A2A2A" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="20" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /></Style>
  </Application.Styles>
</Application>
