<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>businessharness</ToolCommandName>
    <PackageId>BusinessHarness</PackageId>
    <Description>AI repository review, dynamic references, scoped MAGICore memory and optional PR feedback.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://businessharness.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jihadkhawaja/BusinessHarness</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>code-review;ai;cli;security;automation</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BusinessHarness.Application/BusinessHarness.Application.csproj" />
    <ProjectReference Include="../BusinessHarness.Infrastructure/BusinessHarness.Infrastructure.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <None Include="../../external/MAGICore/LICENSE" Pack="true" PackagePath="licenses/MAGICore/" />
    <None Include="../../external/AgentConnector/LICENSE" Pack="true" PackagePath="licenses/AgentConnector/" />
    <None Include="../../external/AgentSpace/LICENSE" Pack="true" PackagePath="licenses/AgentSpace/" />
  </ItemGroup>
</Project>
